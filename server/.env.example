# 咕嘎管家后端环境变量（复制为 .env 使用，或通过 docker-compose / GitHub Secrets 注入）

# 服务端口
PORT=3000

# JWT 密钥（生产环境务必改成随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=30d

# 数据库连接（二选一）
# 方式一：完整连接串
# DATABASE_URL=postgres://guga:guga@localhost:5432/guga
# 方式二：分离字段
PGHOST=localhost
PGPORT=5432
PGDATABASE=guga
PGUSER=guga
PGPASSWORD=guga

# 邮箱验证码 SMTP（可选；不配置则验证码登录/找回密码不可用，密码登录不受影响）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 图片上传目录（默认 server/uploads）
# UPLOAD_DIR=/data/uploads
